{
  "name": "deep-recall-anki-cards",
  "version": "0.1.0",
  "private": true,
  "description": "An Anki card where you write or draw your answer, with optional AI feedback.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:addon": "node addon/build.mjs",
    "install:card": "node scripts/install.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node tests/run-all.mjs",
    "test:ollama": "node tests/ollama.mjs",
    "test:lmstudio": "node tests/lmstudio.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  }
}
